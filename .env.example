# Environment Configuration Template
# Copy this file to .env and fill in your values

# Application Environment
APP_ENV=development  # or 'production'

# Database Configuration
MONGO_URL=mongodb://localhost:27017  # Local dev
# MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority  # Production
DB_NAME=our_website_dev  # or 'our_website_prod'

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Email Service (Optional)
RESEND_API_KEY=your-resend-api-key

# CORS Configuration
CORS_ORIGINS=http://localhost:3000  # Local dev
# CORS_ORIGINS=https://yourdomain.com  # Production

# Application URLs
APP_URL=http://localhost:3000  # Local dev
# APP_URL=https://yourdomain.com  # Production

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000/api/v1  # Local dev
# REACT_APP_API_URL=https://api.yourdomain.com/api/v1  # Production
REACT_APP_APP_URL=http://localhost:3000  # Local dev
# REACT_APP_APP_URL=https://yourdomain.com  # Production
REACT_APP_GA4_ID=
REACT_APP_META_PIXEL_ID=
